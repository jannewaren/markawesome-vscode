      ":::neutral",
      "${1:This is a neutral callout.}",
      ":::"
    ],
    "description": "Insert neutral callout"
  },
  "Callout with Icon": {
    "prefix": "wa-callout-icon",
    "body": [
      ":::${1|info,success,warning,danger,neutral|} icon:${2:icon-name}",
      "${3:Callout content with custom icon.}",
      ":::"
    ],
    "description": "Insert callout with custom icon override"
  },
  "Callout Small": {
    "prefix": "wa-callout-small",
    "body": [
      ":::${1|info,success,warning,danger,neutral|} small",
      "${2:This is a small callout.}",
      ":::"
    ],
    "description": "Insert small callout"
  },
  "Callout Filled": {
    "prefix": "wa-callout-filled",
    "body": [
      ":::${1|info,success,warning,danger,neutral|} filled",
      "${2:This is a filled callout.}",
      ":::"
    ],
    "description": "Insert filled callout"
  },
  "Callout Animated Icon": {
    "prefix": "wa-callout-animation",
    "body": [
      ":::${1|info,success,warning,danger,neutral|} ${2|beat,fade,beat-fade,bounce,flip,shake,spin,spin-pulse,spin-reverse|}",
      "${3:This callout's icon animates.}",
      ":::"
    ],
    "description": "Insert callout with an animated icon (no Pro kit required)"
  },
  "Icon Block": {
    "prefix": "wa-icon",
    "body": [
      ":::wa-icon ${1:bell}",
      "${2:Accessible label}",
      ":::"
    ],
    "description": "Insert icon block with an accessible label"
  },
  "Icon Animated": {
    "prefix": "wa-icon-animation",
    "body": [
      ":::wa-icon ${1:bell} ${2|beat,fade,beat-fade,bounce,flip,shake,spin,spin-pulse,spin-reverse|}",
      ":::"
    ],
    "description": "Insert an animated icon block (no Pro kit required)"
  },
  "Icon Inline": {
    "prefix": "wa-icon-inline",
    "body": [
      "\\$\\$\\$${1:gear}"
    ],
    "description": "Insert an inline (decorative) icon"
  },
  "Card Basic": {
    "prefix": "wa-card",
    "body": [
      "===",
      "${1:Card content here.}",
      "==="
    ],
    "description": "Insert basic card"
  },
  "Card Full": {
    "prefix": "wa-card-full",
    "body": [
      "===${1:filled}",
      "![${2:Alt text}](${3:image.jpg})",
      "# ${4:Card Title}",
      "${5:Card content here.}",
      "[${6:Learn More}](${7:https://example.com})",
      "==="
    ],
    "description": "Insert card with header, image, and footer"
  },
  "Card Filled": {
    "prefix": "wa-card-filled",
    "body": [
      "===filled",
      "# ${1:Card Title}",
      "${2:Card content here.}",
      "==="
    ],
    "description": "Insert filled card"
  },
  "Comparison": {
    "prefix": "wa-comparison",
    "body": [
      "|||${1:50}",
      "![${2:Before}](${3:before.jpg})",
      "![${4:After}](${5:after.jpg})",
      "|||"
    ],
    "description": "Insert image comparison"
  },
  "Carousel Basic": {
    "prefix": "wa-carousel",
    "body": [
      "~~~~~~",
      "~~~",
      "${1:Slide 1}",
      "~~~",
      "~~~",
      "${2:Slide 2}",
      "~~~",
      "~~~",
      "${3:Slide 3}",
      "~~~",
      "~~~~~~"
    ],
    "description": "Insert basic carousel"
  },
  "Carousel Navigation": {
    "prefix": "wa-carousel-nav",
    "body": [
      "~~~~~~navigation pagination ${1:loop}",
      "~~~",
      "${2:Slide 1}",
      "~~~",
      "~~~",
      "${3:Slide 2}",
      "~~~",
      "~~~",
      "${4:Slide 3}",
      "~~~",
      "~~~~~~"
    ],
    "description": "Insert carousel with navigation and pagination"
  },
  "Details": {
    "prefix": "wa-details",
    "body": [
      "^^^${1:filled}",
      "${2:Click to expand}",
      ">>>",
      "${3:Hidden content here.}",
      "^^^"
    ],
    "description": "Insert collapsible details"
  },
  "Details with Icons": {
    "prefix": "wa-details-icons",
    "body": [
      "^^^icon:expand:${1:plus} icon:collapse:${2:minus}",
      "${3:Click to expand}",
      ">>>",
      "${4:Hidden content here.}",
      "^^^"
    ],
    "description": "Insert details with custom expand/collapse icons"
  },
  "Details Open": {
    "prefix": "wa-details-open",
    "body": [
      "^^^open",
      "${1:Initially expanded}",
      ">>>",
      "${2:Visible content here.}",
      "^^^"
    ],
    "description": "Insert initially expanded details"
  },
  "Details Accordion": {
    "prefix": "wa-details-accordion",
    "body": [
      "^^^name:${1:group1}",
      "${2:First item}",
      ">>>",
      "${3:Content 1}",
      "^^^",
      "",
      "^^^name:${1:group1}",
      "${4:Second item}",
      ">>>",
      "${5:Content 2}",
      "^^^"
    ],
    "description": "Insert accordion group (only one open at a time)"
  },
  "Accordion": {
    "prefix": "wa-accordion",
    "body": [
      "//////${1:filled}",
      "/// ${2:First section}",
      "${3:First section content.}",
      "///",
      "/// ${4:Second section}",
      "${5:Second section content.}",
      "///",
      "/// ${6:Third section}",
      "${7:Third section content.}",
      "///",
      "//////"
    ],
    "description": "Insert a multi-section accordion with 3 items"
  },
  "Accordion Single": {
    "prefix": "wa-accordion-single",
    "body": [
      "//////single",
      "/// ${1:First section}",
      "${2:Only one section can be open at a time.}",
      "///",
      "/// ${3:Second section}",
      "${4:Opening this closes the previously open section.}",
      "///",
      "//////"
    ],
    "description": "Insert a single-open accordion (mode: single)"
  },
  "Dialog": {
    "prefix": "wa-dialog",
    "body": [
      "???${1:light-dismiss}",
      "${2:Open Dialog}",
      ">>>",
      "${3:Dialog content here.}",
      "???"
    ],
    "description": "Insert modal dialog"
  },
  "Tab Group": {
    "prefix": "wa-tabs",
    "body": [
      "++++++${1:top}",
      "+++ ${2:Tab 1}",
      "${3:Content 1}",
      "+++",
      "+++ ${4:Tab 2}",
      "${5:Content 2}",
      "+++",
      "+++ ${6:Tab 3}",
      "${7:Content 3}",
      "+++",
      "++++++"
    ],
    "description": "Insert tab group with 3 tabs"
  },
  "Tab Group Manual": {
    "prefix": "wa-tabs-manual",
    "body": [
      "++++++manual",
      "+++ ${1:Tab 1}",
      "${2:Content 1}",
      "+++",
      "+++ ${3:Tab 2}",
      "${4:Content 2}",
      "+++",
      "++++++"
    ],
    "description": "Insert tab group with manual activation (click only)"
  },
  "Tag": {
    "prefix": "wa-tag",
    "body": [
      "@@@${1:brand}",
      "${2:Tag text}",
      "@@@"
    ],
    "description": "Insert tag"
  },
  "Tag with Icon": {
    "prefix": "wa-tag-icon",
