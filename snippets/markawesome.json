  "Grid Layout": {
    "prefix": "wa-grid",
    "body": [
      "::::grid gap:${1:l} min:${2:300px}",
      "${3:Content here}",
      "::::"
    ],
    "description": "Insert responsive grid layout"
  },
  "Grid Layout with Cards": {
    "prefix": "wa-grid-cards",
    "body": [
      "::::grid gap:${1:l} min:${2:300px}",
      "===${3:accent}",
      "# ${4:Card 1}",
      "${5:Content}",
      "===",
      "",
      "===${3:accent}",
      "# ${6:Card 2}",
      "${7:Content}",
      "===",
      "",
      "===${3:accent}",
      "# ${8:Card 3}",
      "${9:Content}",
      "===",
      "::::"
    ],
    "description": "Insert grid layout with 3 cards"
  },
  "Stack Layout": {
    "prefix": "wa-stack",
    "body": [
      "::::stack gap:${1:l}",
      "${2:Content here}",
      "::::"
    ],
    "description": "Insert vertical stack layout"
  },
  "Cluster Layout": {
    "prefix": "wa-cluster",
    "body": [
      "::::cluster gap:${1:s}",
      "${2:Content here}",
      "::::"
    ],
    "description": "Insert inline cluster layout"
  },
  "Cluster Layout with Buttons": {
    "prefix": "wa-cluster-buttons",
    "body": [
      "::::cluster gap:${1:s} justify:${2:center}",
      "%%%brand",
      "[${3:Primary Action}](${4:https://example.com})",
      "%%%",
      "",
      "%%%neutral outlined",
      "[${5:Secondary Action}](${6:https://example.com})",
      "%%%",
      "::::"
    ],
    "description": "Insert cluster layout with button row"
  },
  "Split Layout": {
    "prefix": "wa-split",
    "body": [
      "::::split",
      "${1:Left content}",
      "",
      "${2:Right content}",
      "::::"
    ],
    "description": "Insert split layout (items at opposite ends)"
  },
  "Flank Layout": {
    "prefix": "wa-flank",
    "body": [
      "::::flank ${1:start} size:${2:200px} gap:${3:l}",
      "${4:Sidebar content}",
      "",
      "${5:Main content}",
      "::::"
    ],
    "description": "Insert flank layout (sidebar + main content)"
  },
  "Frame Layout": {
    "prefix": "wa-frame",
    "body": [
      "::::frame ${1|landscape,portrait,square|} radius:${2:l}",
      "<img src=\"${3:image.jpg}\" alt=\"${4:Description}\">",
      "::::"
    ],
    "description": "Insert frame layout (aspect-ratio container)"
  },
  "Popover": {
    "prefix": "wa-popover",
    "body": [
      "&&&${1:top}",
      "${2:Hover for info}",
      ">>>",
      "${3:Popover content here.}",
      "&&&"
    ],
    "description": "Insert popover"
  },
  "Popover with Placement": {
    "prefix": "wa-popover-placement",
    "body": [
      "&&&${1|top,bottom,left,right|}",
      "${2:Hover for info}",
      ">>>",
      "${3:Popover content here.}",
      "&&&"
    ],
    "description": "Insert popover with placement selection"
  },
  "Popover Link": {
    "prefix": "wa-popover-link",
    "body": [
      "&&&${1:top} link",
      "${2:Learn more}",
      ">>>",
      "${3:Popover content here.}",
      "&&&"
    ],
    "description": "Insert popover with link-styled trigger"
  },
  "Popover Inline": {
    "prefix": "wa-popover-inline",
    "body": "&&&${1:trigger text} >>> ${2:popover content}&&&",
    "description": "Insert inline popover (for use within sentences)"
  },
  "Tooltip": {
    "prefix": "wa-tooltip",
    "body": [
      ":::wa-tooltip ${1|top,bottom,left,right|}",
      "${2:anchor term}",
      ">>>",
      "${3:tip text}",
      ":::"
    ],
    "description": "Insert tooltip (block alternative syntax)"
  },
  "Tooltip Inline": {
    "prefix": "wa-tooltip-inline",
    "body": "(((${1:term} >>> ${2:tip})))",
    "description": "Insert inline tooltip (for use within sentences)"
  },
  "Alternative Callout": {
    "prefix": "wa-alt-callout",
    "body": [
      ":::wa-callout ${1:info}",
      "${2:Callout content}",
      ":::"
    ],
    "description": "Insert callout (alternative syntax)"
  },
  "Alternative Card": {
    "prefix": "wa-alt-card",
    "body": [
      ":::wa-card ${1:filled}",
      "${2:Card content}",
      ":::"
    ],
    "description": "Insert card (alternative syntax)"
  },
  "Alternative Details": {
    "prefix": "wa-alt-details",
    "body": [
      ":::wa-details ${1:filled}",
      "${2:Summary text}",
      ">>>",
      "${3:Details content}",
      ":::"
    ],
    "description": "Insert details (alternative syntax)"
  }
